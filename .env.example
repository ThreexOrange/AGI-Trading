# Examples only. Inject real values through the runtime's secret/environment UI.
# This program does not automatically load .env files.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_DEMO_API_KEY=
BITGET_DEMO_SECRET_KEY=
BITGET_DEMO_PASSPHRASE=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Optional: official supported regional Bybit host, validated against an allowlist.
# BYBIT_API_HOST=api.bybit.com
# Defaults: paper order mode, 100 USDT maximum per order, BTCUSDT/ETHUSDT only.
AGI_TRADING_MAX_ORDER_USDT=100
AGI_TRADING_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
AGI_TRADING_ENABLE_LIVE=0
# State must stay outside this public repository. Default: ~/.local/state/agi-trading
# AGI_TRADING_STATE_DIR=/private/persistent/location/agi-trading
